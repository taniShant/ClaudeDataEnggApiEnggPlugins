{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AbInitioDiscoveryLineageOutput",
  "description": "Schema for the output of the ab-initio-discovery-agent. Defines the structure of field source maps, workbook metadata, OpenLineage events, and validation results.",
  "type": "object",
  "required": [
    "namespace",
    "target_dataset",
    "execution_timestamp",
    "field_source_map",
    "workbook_metadata",
    "openlineage_events",
    "validation_results"
  ],
  "properties": {
    "namespace": {
      "type": "string",
      "description": "OpenLineage namespace identifier.",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "target_dataset": {
      "type": "string",
      "description": "Target dataset name (e.g., my_target_dataset)."
    },
    "target_dml_path": {
      "type": "string",
      "description": "Path to the target DML file."
    },
    "graph_name": {
      "type": "string",
      "description": "Primary graph .mp filename."
    },
    "execution_timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 timestamp of execution."
    },
    "field_source_map": {
      "type": "array",
      "description": "One entry per target attribute with complete source tracing.",
      "items": {
        "type": "object",
        "required": ["name", "dtype", "teradata_sources", "transformation_type", "multi_source"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Attribute name exactly as it appears in the target DML."
          },
          "dtype": {
            "type": "string",
            "description": "Exact datatype from DML (e.g., 'big endian decimal(16,0,binary)', 'hive_string_t')."
          },
          "found_in": {
            "type": "array",
            "items": { "type": "string" },
            "description": "List of intermediate DML labels where this field was found."
          },
          "teradata_sources": {
            "type": "array",
            "items": { "type": "string" },
            "description": "List of actual Teradata source table names confirmed by RES dependency tree."
          },
          "transformation_type": {
            "type": "string",
            "enum": ["DIRECT_MAPPING", "RENAME", "DERIVATION", "JOIN", "LOOKUP", "AGGREGATION", "FILTER", "CONDITIONAL_RULE", "CONSTANT", "SYSTEM_GENERATED", "UNKNOWN"],
            "description": "Classification of how this field is produced."
          },
          "multi_source": {
            "type": "boolean",
            "description": "True if this attribute is derived from fields in multiple Teradata source tables."
          },
          "transformation_note": {
            "type": "string",
            "description": "Human-readable description of the transformation logic."
          },
          "confidence": {
            "type": "string",
            "enum": ["HIGH", "MEDIUM", "LOW"],
            "description": "Confidence level for this mapping."
          }
        }
      }
    },
    "workbook_metadata": {
      "type": "object",
      "required": ["filename", "total_attributes", "sheets"],
      "properties": {
        "filename": { "type": "string" },
        "total_attributes": { "type": "integer", "minimum": 1 },
        "sheets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "row_count", "column_count"],
            "properties": {
              "name": { "type": "string" },
              "row_count": { "type": "integer" },
              "column_count": { "type": "integer" }
            }
          }
        }
      }
    },
    "openlineage_events": {
      "type": "array",
      "description": "OpenLineage RunEvents (START + COMPLETE pairs per graph).",
      "items": {
        "type": "object",
        "required": ["eventType", "eventTime", "run", "job"],
        "properties": {
          "eventType": {
            "type": "string",
            "enum": ["START", "COMPLETE", "FAIL", "ABORT"]
          },
          "eventTime": {
            "type": "string",
            "format": "date-time"
          },
          "run": { "type": "object" },
          "job": { "type": "object" },
          "inputs": { "type": "array" },
          "outputs": { "type": "array" }
        }
      }
    },
    "validation_results": {
      "type": "object",
      "required": ["total_checks", "passed", "failed", "checks"],
      "properties": {
        "total_checks": { "type": "integer" },
        "passed": { "type": "integer" },
        "failed": { "type": "integer" },
        "critical_failures": { "type": "integer" },
        "publication_blocked": { "type": "boolean" },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "description", "severity", "status"],
            "properties": {
              "id": { "type": "string" },
              "description": { "type": "string" },
              "severity": { "type": "string", "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"] },
              "status": { "type": "string", "enum": ["PASS", "FAIL", "SKIP"] },
              "detail": { "type": "string" }
            }
          }
        }
      }
    },
    "res_dependency_tree": {
      "type": "object",
      "description": "Recursive RES dependency tree from target job to Teradata sources.",
      "properties": {
        "root_job": { "type": "string" },
        "root_schedule": { "type": "string" },
        "teradata_sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "job_name": { "type": "string" },
              "table_name": { "type": "string" },
              "description": { "type": "string" }
            }
          }
        },
        "total_jobs_in_tree": { "type": "integer" }
      }
    },
    "publication_report": {
      "type": "object",
      "description": "Present only when upload_flag is true.",
      "properties": {
        "endpoint": { "type": "string" },
        "events_sent": { "type": "integer" },
        "events_succeeded": { "type": "integer" },
        "events_failed": { "type": "integer" }
      }
    }
  }
}
