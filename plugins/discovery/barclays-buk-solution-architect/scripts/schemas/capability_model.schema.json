{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "capability_model.schema.json",
  "title": "BUK Capability Model Domain",
  "description": "Schema for authoritative domain capability model YAML files. Validates domain, sub-domain, and capability structure, hierarchy, and identifier uniqueness.",
  "type": "object",
  "required": ["schema_version", "domain"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0",
      "description": "Model schema version. Must be '1.0'."
    },
    "domain": {
      "type": "object",
      "required": ["id", "name", "description", "owner", "sub_domains"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^dom\\.[a-z0-9-]+$",
          "description": "Domain identifier: format dom.{slug}"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable domain name"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "Domain description and scope"
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "description": "Domain owner or owning team"
        },
        "bian_links": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["title", "url"],
            "additionalProperties": false,
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "format": "uri"
              }
            }
          },
          "description": "Optional BIAN (Business Information Architecture Network) linkage"
        },
        "sub_domains": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "name", "description", "capabilities"],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^sub\\.[a-z0-9-]+\\.[a-z0-9-]+$",
                "description": "Sub-domain identifier: format sub.{domain_slug}.{subdomain_slug}"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "description": "Sub-domain name"
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "description": "Sub-domain description"
              },
              "capabilities": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["id", "name", "description"],
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^cap\\.[a-z0-9-]+\\.[a-z0-9-]+$",
                      "description": "Capability identifier: format cap.{domain_slug}.{capability_slug}"
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Capability name"
                    },
                    "description": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Capability description and scope"
                    },
                    "links": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["title", "url"],
                        "additionalProperties": false,
                        "properties": {
                          "title": {
                            "type": "string",
                            "minLength": 1
                          },
                          "url": {
                            "type": "string",
                            "format": "uri"
                          }
                        }
                      },
                      "description": "Optional documentation links"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
