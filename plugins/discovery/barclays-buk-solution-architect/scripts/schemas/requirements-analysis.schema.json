{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Requirements Analysis",
  "description": "Canonical requirements analysis derived from demand sources (Jira, PRD, Brief, etc.). Source-neutral contract.",
  "type": "object",
  "required": [
    "schema_version",
    "analysis_metadata",
    "source_evidence",
    "change_summary",
    "explicit_requirements",
    "inferred_requirements",
    "constraints_and_dependencies",
    "ambiguities_and_unknowns",
    "key_concepts"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["2.0"],
      "description": "Canonical schema version. Supports v2.0 (multi-source)."
    },
    "analysis_metadata": {
      "type": "object",
      "required": ["analyzed_at"],
      "properties": {
        "analyzed_at": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp when analysis was performed"
        }
      }
    },
    "source_evidence": {
      "type": "array",
      "minItems": 1,
      "description": "Array of authoritative demand sources. Multi-source support: PRD + Brief, Jira alone, etc.",
      "items": {
        "type": "object",
        "required": ["source_type", "source_identifier", "sha256"],
        "properties": {
          "source_type": {
            "type": "string",
            "enum": ["jira", "prd", "brief"],
            "description": "Type of demand source"
          },
          "source_identifier": {
            "type": "string",
            "description": "Unique identifier within source type. For Jira: issue_key. For PRD/Brief: filename or URL."
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "description": "SHA-256 hash of source content for integrity verification"
          },
          "jira": {
            "type": "object",
            "description": "Jira-specific provenance (only when source_type='jira')",
            "properties": {
              "instance": {
                "type": "string",
                "description": "Jira instance domain"
              },
              "issue_key": {
                "type": "string",
                "description": "Jira issue key"
              }
            }
          }
        }
      }
    },
    "change_summary": {
      "type": "object",
      "required": ["outcome", "rationale", "supporting_evidence"],
      "properties": {
        "outcome": {
          "type": "string",
          "description": "High-level change outcome"
        },
        "rationale": {
          "type": "string",
          "description": "Why this change matters"
        },
        "supporting_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/evidence_reference"
          }
        }
      }
    },
    "explicit_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "requirement", "supporting_evidence"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Requirement identifier (e.g., ER001, FR-1)"
          },
          "requirement": {
            "type": "string",
            "description": "The explicit requirement statement"
          },
          "supporting_evidence": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/evidence_reference"
            }
          }
        }
      }
    },
    "inferred_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "requirement", "reasoning", "supporting_evidence"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Requirement identifier (e.g., IR001)"
          },
          "requirement": {
            "type": "string",
            "description": "The inferred requirement statement"
          },
          "reasoning": {
            "type": "string",
            "description": "Logical reasoning for the inference"
          },
          "supporting_evidence": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/evidence_reference"
            }
          }
        }
      }
    },
    "constraints_and_dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "constraint", "is_explicit", "supporting_evidence"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Constraint identifier (e.g., CD001)"
          },
          "constraint": {
            "type": "string",
            "description": "The constraint or dependency statement"
          },
          "is_explicit": {
            "type": "boolean",
            "description": "True if explicitly stated in source; false if inferred"
          },
          "supporting_evidence": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/evidence_reference"
            }
          }
        }
      }
    },
    "ambiguities_and_unknowns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "ambiguity", "impact", "clarification_needed"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Ambiguity identifier (e.g., AMB001)"
          },
          "ambiguity": {
            "type": "string",
            "description": "Description of the ambiguous or unknown aspect"
          },
          "impact": {
            "type": "string",
            "description": "Impact of the ambiguity on solution design"
          },
          "clarification_needed": {
            "type": "string",
            "description": "What clarification is needed (not a recommendation)"
          },
          "supporting_evidence": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/evidence_reference"
            }
          }
        }
      }
    },
    "key_concepts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["concept", "definition", "supporting_evidence"],
        "properties": {
          "concept": {
            "type": "string",
            "description": "Key concept or term"
          },
          "definition": {
            "type": "string",
            "description": "Clear definition in domain context"
          },
          "supporting_evidence": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/evidence_reference"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "evidence_reference": {
      "type": "object",
      "required": ["evidence_id", "source_type"],
      "properties": {
        "evidence_id": {
          "type": "string",
          "description": "Identifier of evidence unit. Format depends on source_type. Examples: 'description:0' (Jira), 'FR-1' (PRD), 'problem:0' (Brief)."
        },
        "source_type": {
          "type": "string",
          "enum": ["jira", "prd", "brief"],
          "description": "Which source this evidence comes from"
        },
        "source_value": {
          "description": "Resolved source text or structured content. May be string, dict, or null if unresolved.",
          "oneOf": [
            { "type": "string" },
            { "type": "object" },
            { "type": "null" }
          ]
        }
      }
    }
  }
}
