{
  "$schema": "sttm-plugin/v1/core",
  "target_source": {
    "format": "excel",
    "artifact": "input/target_schema.xlsx"
  },
  "target": {
    "database": "fdp_uk_payments_db",
    "table": "payment_transaction",
    "table_description": "Foundation Data Product - payment transaction event records",
    "table_type": "Transactional",
    "columns": [
      {"name": "payment_transaction_id", "description": "Unique payment transaction identifier", "datatype": "string", "nullable": "N", "key_column": "Y"},
      {"name": "account_id", "description": "Account associated with payment", "datatype": "string", "nullable": "N", "key_column": "N"},
      {"name": "payment_amount", "description": "Payment amount", "datatype": "decimal(18,2)", "nullable": "Y", "key_column": "N"},
      {"name": "payment_method", "description": "Method of payment", "datatype": "string", "nullable": "Y", "key_column": "N"},
      {"name": "transaction_date", "description": "Date of transaction", "datatype": "date", "nullable": "N", "key_column": "N"},
      {"name": "dw_bus_dt", "description": "Business date partition", "datatype": "date", "nullable": "N", "key_column": "N"},
      {"name": "dw_lod_tmp", "description": "Load timestamp", "datatype": "timestamp", "nullable": "N", "key_column": "N"}
    ]
  },
  "sources": [
    {
      "database": "e_payments_db",
      "table": "txn_log",
      "columns": [
        {"name": "txn_id", "datatype": "string"},
        {"name": "acct_num", "datatype": "string"},
        {"name": "amt", "datatype": "float"},
        {"name": "method_code", "datatype": "string"},
        {"name": "txn_dte", "datatype": "int"}
      ]
    }
  ],
  "code": {
    "type": "sql",
    "content": "SELECT txn_id AS payment_transaction_id, acct_num AS account_id, CAST(amt AS DECIMAL(18,2)) AS payment_amount, COALESCE(method_code, 'UNKNOWN') AS payment_method, CAST(TO_DATE(CAST(txn_dte AS STRING), 'yyyyMMdd') AS DATE) AS transaction_date FROM e_payments_db.txn_log"
  },
  "configuration": {
    "load_type": "Day1",
    "partition_columns": ["dw_bus_dt"],
    "audit_columns": {"load_timestamp": "dw_lod_tmp"}
  }
}
