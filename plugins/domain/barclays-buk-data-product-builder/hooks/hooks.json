{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT:-.}/scripts/hooks/platform-lock-check.sh\" || exit 0",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "if": "Bash(git *)",
        "hooks": [
          {
            "type": "command",
            "command": "cmd=$(jq -r '.tool_input.command // empty' 2>/dev/null); if echo \"$cmd\" | grep -qE 'git[[:space:]].*([[:space:]]--force|-f[[:space:]]|[[:space:]]reset[[:space:]]|[[:space:]]clean[[:space:]])'; then echo '{\"hookSpecificOutput\":{\"decision\":\"block\",\"reason\":\"Destructive git operation requires confirmation\"}}' >&2; exit 2; fi",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT:-.}/scripts/hooks/automation-gate.sh\" || exit 0",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "if": "Write(session/**)|Edit(session/**)",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT:-.}/scripts/hooks/session-state-persist.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "if": "Write(generated/**)|Edit(generated/**)",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT:-.}/scripts/hooks/post-generate-validate.sh\" || exit 0",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT:-.}/scripts/hooks/pycache-cleanup.sh\" || exit 0",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
