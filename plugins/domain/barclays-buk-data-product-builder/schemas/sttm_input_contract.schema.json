{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sttm-plugin/v1/core",
  "title": "STTM Plugin Input Contract",
  "description": "JSON Schema for validating STTM Generator Plugin input files",
  "type": "object",
  "required": ["target"],
  "properties": {
    "$schema": {
      "type": "string",
      "enum": ["sttm-plugin/v1/core", "sttm-plugin/v1/extended"]
    },
    "target_source": {
      "type": "object",
      "properties": {
        "format": {"type": "string", "enum": ["excel", "markdown"]},
        "artifact": {"type": "string"}
      },
      "required": ["format", "artifact"]
    },
    "target": {
      "type": "object",
      "required": ["database", "table", "columns"],
      "properties": {
        "database": {"type": "string", "pattern": "^[a-z][a-z0-9_]*_db$"},
        "table": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "table_description": {"type": "string"},
        "table_type": {"type": "string", "enum": ["scd2", "scd1", "transactional"]},
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "datatype", "nullable"],
            "properties": {
              "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
              "description": {"type": "string"},
              "datatype": {"type": "string"},
              "nullable": {"type": "string", "enum": ["Y", "N"]},
              "key_column": {"type": "string", "enum": ["Y", "N"]}
            }
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["database", "table"],
        "properties": {
          "database": {"type": "string"},
          "table": {"type": "string"},
          "columns": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "datatype"],
              "properties": {
                "name": {"type": "string"},
                "datatype": {"type": "string"},
                "sensitivity": {"type": "string"}
              }
            }
          }
        }
      }
    },
    "source_mapping": {
      "type": "object",
      "properties": {
        "format": {"type": "string", "enum": ["excel", "csv", "json"]},
        "artifact": {"type": "string"},
        "description": {"type": "string"},
        "column_map": {"type": "object"}
      }
    },
    "code": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "content"],
          "properties": {
            "type": {"type": "string", "enum": ["sql", "pyspark"]},
            "artifact": {"type": "string"},
            "content": {"type": "string"}
          }
        },
        {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "content"],
            "properties": {
              "type": {"type": "string", "enum": ["sql", "pyspark"]},
              "artifact": {"type": "string"},
              "content": {"type": "string"}
            }
          }
        }
      ]
    },
    "crypto": {
      "type": "object",
      "properties": {
        "direction": {"type": "string", "enum": ["detokenize", "tokenize", "both"]},
        "detokenize": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source_column", "source_de"],
            "properties": {
              "source_column": {"type": "string"},
              "target_column": {"type": "string"},
              "source_de": {"type": "string"},
              "udf": {"type": "string"}
            }
          }
        },
        "retokenize": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["target_column", "target_de"],
            "properties": {
              "target_column": {"type": "string"},
              "target_de": {"type": "string"},
              "udf": {"type": "string"}
            }
          }
        }
      }
    },
    "profiling": {
      "type": "object",
      "description": "Profiling data — populated from Excel report or user answers only. OPTIONAL; plugin must NOT assume this exists or that profiling_signals.json is present.",
      "properties": {
        "source_type": {
          "type": "string",
          "enum": ["excel_report", "user_supplied"],
          "description": "Identifies the origin of the profiling data"
        },
        "source_artifact": {
          "type": "string",
          "description": "File path for Excel report or 'user_interview' for user-supplied answers"
        },
        "source": {"type": "string"},
        "stats": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "table": {"type": "string"},
              "column": {"type": "string"},
              "row_count": {"type": "integer"},
              "null_pct": {"type": "number"},
              "distinct_count": {"type": "integer"},
              "min_value": {"type": "string"},
              "max_value": {"type": "string"},
              "uniqueness_ratio": {"type": "number"}
            }
          }
        }
      }
    },
    "joins": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "left": {"type": "string"},
          "right": {"type": "string"},
          "type": {"type": "string", "enum": ["LEFT", "INNER", "RIGHT", "FULL"]},
          "on": {"type": "string"}
        }
      }
    },
    "multi_source": {
      "type": "object",
      "properties": {
        "strategy": {"type": "string", "enum": ["join", "union"]},
        "primary_source": {"type": "string"},
        "secondary_sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source": {"type": "string"},
              "join_type": {"type": "string"},
              "join_key": {"type": "string"}
            }
          }
        }
      }
    },
    "aggregations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "target_column": {"type": "string"},
          "function": {"type": "string"},
          "source_column": {"type": "string"},
          "partition_by": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "data_model": {
      "type": "object",
      "properties": {
        "format": {"type": "string", "enum": ["dm1", "json"]},
        "artifact": {"type": "string"},
        "extracted": {"type": "object"}
      }
    },
    "markdown_documents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {"type": "string", "enum": ["hld", "requirements", "source_schema"]},
          "artifact": {"type": "string"},
          "extracted_context": {"type": "object"}
        }
      }
    },
    "configuration": {
      "type": "object",
      "properties": {
        "load_type": {"type": "string", "enum": ["Day0", "Day1", "BAU"]},
        "scenario": {"type": "string"},
        "audit_columns": {"type": "object"},
        "partition_columns": {"type": "array", "items": {"type": "string"}},
        "cdc_hash_exclusions": {"type": "array", "items": {"type": "string"}},
        "scd": {
          "type": "object",
          "properties": {
            "type": {"type": "string", "enum": ["scd2", "scd1"]},
            "effective_start": {"type": "string"},
            "effective_end": {"type": "string"},
            "active_flag": {"type": "string"},
            "high_end_date": {"type": "string"},
            "source_mod_column": {"type": "string"}
          }
        }
      }
    },
    "merge_strategy": {
      "type": "string",
      "enum": ["close_insert", "update_in_place"],
      "description": "For MERGE statements: how the matched branch handles existing records"
    },
    "pyspark_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "variable_name": {"type": "string"},
          "read_method": {"type": "string", "enum": ["spark.table", "spark.read.format", "spark.read.parquet", "spark.read.csv", "spark.read.json"]},
          "logical_table": {"type": "string", "description": "database.table logical name"}
        }
      },
      "description": "Pre-mapped PySpark source table names for path-based reads"
    },
    "user_instructions": {"type": "string"}
  }
}
